# Public HTTPS origin used by ChatGPT, Keycloak, and the MCP resource metadata.
PUBLIC_BASE_URL=https://mcp.example.com

# Copy the exact callback URL shown by ChatGPT. Do not shorten it or add a slash.
CHATGPT_CALLBACK_URL=https://chatgpt.com/connector/oauth/REPLACE_WITH_CALLBACK_ID

# OAuth client credentials entered in ChatGPT's app configuration.
OAUTH_CLIENT_ID=chatgpt-mcp
OAUTH_CLIENT_SECRET=replace-with-a-long-random-secret
OAUTH_AUDIENCE=mcp-server
OAUTH_REQUIRED_SCOPES=mcp:tools
OAUTH_ENABLED=true

# Initial realm user. The first login forces a password change.
MCP_USER=mcp-user
MCP_USER_EMAIL=you@example.com
MCP_USER_PASSWORD=replace-with-a-strong-temporary-password

# Local Keycloak administrator, available only on 127.0.0.1:8081 by default.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_ADMIN_PORT=8081
KEYCLOAK_ADMIN_URL=http://localhost:8081

# Database password.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional Cloudflare Tunnel. Required only with: docker compose --profile tunnel up
CLOUDFLARE_TUNNEL_TOKEN=

# Local gateway port and sandbox limits.
GATEWAY_PORT=8080
MAX_TIMEOUT_SECONDS=300
MAX_OUTPUT_BYTES=524288
MAX_FILE_BYTES=2097152
SANDBOX_UID=10001
SANDBOX_GID=10001
