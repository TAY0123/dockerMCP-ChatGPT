# Docker MCP ChatGPT defaults
#
# Quick Tunnel: no changes are required for a disposable test.
# Run: bash scripts/quick-tunnel.sh
#
# The callback wildcard is convenient for testing. For a stable deployment,
# replace it with the exact callback URL displayed by ChatGPT.
CHATGPT_CALLBACK_URL=https://chatgpt.com/connector/oauth/*

# Public origin. The Quick Tunnel helper replaces this automatically.
PUBLIC_BASE_URL=http://localhost:8080

# OAuth defaults entered in ChatGPT.
OAUTH_ENABLED=true
OAUTH_CLIENT_ID=chatgpt-mcp
OAUTH_CLIENT_SECRET=auto
OAUTH_AUDIENCE=mcp-server
OAUTH_REQUIRED_SCOPES=mcp:tools

# OAuth login account created in Keycloak.
MCP_USER=mcp-user
MCP_USER_EMAIL=mcp-user@example.invalid
MCP_USER_PASSWORD=auto

# Local Keycloak administrator.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=auto
KEYCLOAK_ADMIN_PORT=8081
KEYCLOAK_ADMIN_URL=http://localhost:8081

# Keycloak database credential.
POSTGRES_PASSWORD=auto

# Optional stable named Cloudflare Tunnel token.
# Leave empty when using scripts/quick-tunnel.sh.
CLOUDFLARE_TUNNEL_TOKEN=

# Local ports and command limits.
GATEWAY_PORT=8080
MAX_TIMEOUT_SECONDS=300
MAX_OUTPUT_BYTES=524288
MAX_FILE_BYTES=2097152

# Internal image user IDs used by the non-root MCP service.
SANDBOX_UID=10001
SANDBOX_GID=10001
